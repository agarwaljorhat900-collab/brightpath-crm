# BrightPath CRM — Environment Configuration
# Copy this file to .env and fill in your Supabase project credentials.
# Do NOT commit your actual .env file or put service-role keys in this file.

# Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Client Key (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_ANON_KEY=your-public-client-key
